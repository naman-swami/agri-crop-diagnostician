  "parameters": {
    "type": "object",
    "properties": {
      "plot_id": {
        "type": "string"
      },
      "spectral_bands": {
        "type": "string"
      },
      "target_crop": {
        "type": "string"
      }
    },
    "required": [
      "plot_id",
      "spectral_bands",
      "target_crop"
    ]
  }
}